// ----------------------------------------------------------------------------
// Display Folder: 07_Data_Quality_Governance
// ----------------------------------------------------------------------------

Missing Value Total = 
0
// Format: #,##0
// Description: Confirmed missing values in cleaned dataset

Duplicate Record Total = 
0
// Format: #,##0
// Description: Confirmed duplicate rows in cleaned dataset

Negative Amount Violations = 
0
// Format: #,##0
// Description: Violations of positive transaction amount constraint

Heuristic Flag Triggered Total = 
16
// Format: #,##0
// Description: Total transactions flagged by legacy isFlaggedFraud heuristic rule

Heuristic Flag TP = 
16
// Format: #,##0
// Description: True positive fraud alerts triggered by heuristic rule

Heuristic Flag FP = 
0
// Format: #,##0
// Description: False positive fraud alerts triggered by heuristic rule

Heuristic Flag FN = 
8197
// Format: #,##0
// Description: Fraud transactions missed by heuristic rule (8,197 / 8,213)

Heuristic Flag TN = 
6354407
// Format: #,##0
// Description: Legitimate transactions correctly cleared by heuristic rule

Heuristic Flag Precision = 
DIVIDE([Heuristic Flag TP], [Heuristic Flag TP] + [Heuristic Flag FP], 0)
// Format: 0.00%
// Description: Legacy rule precision (100.00%)

Heuristic Flag Recall = 
DIVIDE([Heuristic Flag TP], [Heuristic Flag TP] + [Heuristic Flag FN], 0)
// Format: 0.0000%
// Description: Legacy rule recall (0.1948% = 16 / 8,213)
