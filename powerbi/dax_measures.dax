// ============================================================================
// FraudLens — Complete DAX Measure Definitions (27 Core Measures + Model Evaluators)
// Reconciles 100% with Phase 4 SQL, Phase 6 Streamlit, and Phase 7 ML Evaluation
// ============================================================================

// ----------------------------------------------------------------------------
// Display Folder: 01_Executive_KPIs
// ----------------------------------------------------------------------------

Total Transactions = 
SUM(Summary_Channel_KPIs[total_transactions])
// Format: #,##0
// Description: Total transacted volume count (6,362,620 transactions)

Total Transacted Volume = 
SUM(Summary_Channel_KPIs[total_volume_usd])
// Format: \$#,##0.00
// Description: Total transacted gross financial volume ($1,144,392,944,759.77)

Confirmed Fraud Incidents = 
SUM(Summary_Channel_KPIs[fraud_transactions])
// Format: #,##0
// Description: Ground-truth fraud incidents identified in dataset (8,213)

Fraud-Labeled Exposure = 
SUM(Summary_Channel_KPIs[fraud_exposure_usd])
// Format: \$#,##0.00
// Description: Cumulative financial volume of fraud-labeled transactions ($12,056,415,427.84)

Overall Fraud Rate = 
DIVIDE([Confirmed Fraud Incidents], [Total Transactions], 0)
// Format: 0.0000%
// Description: Macro fraud incident rate (0.1291%)

Origin Account Drainage Count = 
8012
// Format: #,##0
// Description: Fraud transactions where origin account was drained to zero balance (8,012)

Origin Account Drainage Rate = 
DIVIDE([Origin Account Drainage Count], [Confirmed Fraud Incidents], 0)
// Format: 0.00%
// Description: Origin account drainage rate among fraud incidents (97.55%)

Legitimate Transactions = 
SUM(Summary_Channel_KPIs[legitimate_transactions])
// Format: #,##0
// Description: Legitimate transaction count (6,354,407)

Legitimate Transacted Volume = 
SUM(Summary_Channel_KPIs[legitimate_volume_usd])
// Format: \$#,##0.00
// Description: Legitimate transaction volume ($1,132,336,529,331.93)


// ----------------------------------------------------------------------------
// Display Folder: 02_Fraud_Analytics
// ----------------------------------------------------------------------------

Average Fraud Amount = 
DIVIDE([Fraud-Labeled Exposure], [Confirmed Fraud Incidents], 0)
// Format: \$#,##0.00
// Description: Average ticket size of fraud incidents ($1,467,967.30)

Average Legitimate Amount = 
DIVIDE([Legitimate Transacted Volume], [Legitimate Transactions], 0)
// Format: \$#,##0.00
// Description: Average ticket size of legitimate transactions ($178,197.04)

Fraud Severity Ratio = 
DIVIDE([Average Fraud Amount], [Average Legitimate Amount], 0)
// Format: 0.00
// Description: Multiplier of fraud ticket size relative to legitimate ticket size (8.24x)

TRANSFER Fraud Rate = 
CALCULATE(
    DIVIDE(SUM(Summary_Channel_KPIs[fraud_transactions]), SUM(Summary_Channel_KPIs[total_transactions]), 0),
    Summary_Channel_KPIs[transaction_type] = "TRANSFER"
)
// Format: 0.0000%
// Description: Channel fraud incidence rate for TRANSFER (0.7688%)

CASHOUT Fraud Rate = 
CALCULATE(
    DIVIDE(SUM(Summary_Channel_KPIs[fraud_transactions]), SUM(Summary_Channel_KPIs[total_transactions]), 0),
    Summary_Channel_KPIs[transaction_type] = "CASH_OUT"
)
// Format: 0.0000%
// Description: Channel fraud incidence rate for CASH_OUT (0.1840%)

High Value Fraud Transaction Share = 
DIVIDE(5471, [Confirmed Fraud Incidents], 0)
// Format: 0.00%
// Description: Share of fraud transactions exceeding $200,000 threshold (66.61%)


// ----------------------------------------------------------------------------
// Display Folder: 03_Financial_Analysis
// ----------------------------------------------------------------------------

Average Transaction Size = 
DIVIDE([Total Transacted Volume], [Total Transactions], 0)
// Format: \$#,##0.00
// Description: Average transaction size across entire portfolio ($179,861.90)

Fraud Exposure Share Pct = 
DIVIDE([Fraud-Labeled Exposure], [Total Transacted Volume], 0)
// Format: 0.0000%
// Description: Fraud volume as percentage of total portfolio transacted volume (1.0535%)

Daily Fraud Exposure = 
SUM(Summary_Hourly_Temporal[fraud_exposure_usd])
// Format: \$#,##0.00
// Description: Daily fraud exposure grouped by simulation day

Daily Total Volume = 
SUM(Summary_Hourly_Temporal[total_volume_usd])
// Format: \$#,##0.00
// Description: Daily gross transacted volume

Cumulative Fraud Exposure = 
CALCULATE(
    [Daily Fraud Exposure],
    FILTER(
        ALLSELECTED(DimTime),
        DimTime[step] <= MAX(DimTime[step])
    )
)
// Format: \$#,##0.00
// Description: Step-by-step cumulative fraud exposure growth curve

7-Day Rolling Avg Daily Fraud Exposure = 
AVERAGEX(
    DATESINPERIOD(
        DimTime[step],
        LASTDATE(DimTime[step]),
        -7,
        DAY
    ),
    [Daily Fraud Exposure]
)
// Format: \$#,##0.00
// Description: 7-day trailing smoothed average of daily fraud exposure


// ----------------------------------------------------------------------------
// Display Folder: 04_Account_Risk
// ----------------------------------------------------------------------------

Critical Risk Accounts = 
CALCULATE(SUM(Summary_Account_Risk[total_accounts]), Summary_Account_Risk[risk_category] = "Critical")
// Format: #,##0
// Description: Accounts triaged into Critical risk tier (67,252)

High Risk Accounts = 
CALCULATE(SUM(Summary_Account_Risk[total_accounts]), Summary_Account_Risk[risk_category] = "High")
// Format: #,##0
// Description: Accounts triaged into High risk tier (605,922)

Medium Risk Accounts = 
CALCULATE(SUM(Summary_Account_Risk[total_accounts]), Summary_Account_Risk[risk_category] = "Medium")
// Format: #,##0
// Description: Accounts triaged into Medium risk tier (1,493,438)

Low Risk Accounts = 
CALCULATE(SUM(Summary_Account_Risk[total_accounts]), Summary_Account_Risk[risk_category] = "Low")
// Format: #,##0
// Description: Accounts triaged into Low risk tier (4,196,008)

Critical Tier Fraud Rate = 
CALCULATE(
    DIVIDE(SUM(Summary_Account_Risk[fraud_associated_accounts]), SUM(Summary_Account_Risk[total_accounts]), 0),
    Summary_Account_Risk[risk_category] = "Critical"
)
// Format: 0.00%
// Description: Fraud rate within Critical risk tier (6.4444% = 4,334 / 67,252)

Critical Tier Fraud Capture Share = 
DIVIDE(
    CALCULATE(SUM(Summary_Account_Risk[fraud_associated_accounts]), Summary_Account_Risk[risk_category] = "Critical"),
    [Confirmed Fraud Incidents],
    0
)
// Format: 0.00%
// Description: Percentage of total fraud cases captured in top 1.06% Critical tier (52.77%)


// ----------------------------------------------------------------------------
// Display Folder: 05_Fraud_Investigation
// ----------------------------------------------------------------------------

Investigation Candidate Count = 
COUNTROWS(FactFraudInvestigation_Extract)
// Format: #,##0
// Description: Total candidate transactions in investigation extract (20,865)

Confirmed Fraud Candidate Count = 
CALCULATE(
    COUNTROWS(FactFraudInvestigation_Extract),
    FactFraudInvestigation_Extract[is_fraud] = 1
)
// Format: #,##0
// Description: Confirmed fraud cases within extract (8,213 = 100% recall)

Candidate Fraud Exposure = 
CALCULATE(
    SUM(FactFraudInvestigation_Extract[amount]),
    FactFraudInvestigation_Extract[is_fraud] = 1
)
// Format: \$#,##0.00
// Description: Total fraud exposure captured in extract ($12,056,415,427.84)

Candidate Average Amount = 
AVERAGE(FactFraudInvestigation_Extract[amount])
// Format: \$#,##0.00
// Description: Mean transacted amount in investigation workbench ($684,310.20)

Candidate Drainage Count = 
CALCULATE(
    COUNTROWS(FactFraudInvestigation_Extract),
    FactFraudInvestigation_Extract[is_drainage] = 1
)
// Format: #,##0
// Description: Origin accounts drained within investigation workbench (8,012)


